# Copy to .env and supply a local-only password before using Docker Compose.
POSTGRES_DB=fresveg
POSTGRES_USER=fresveg_bootstrap
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379

# Maven bootstrap reads exported environment variables, not this file automatically.
BOOTSTRAP_DB_URL=jdbc:postgresql://localhost:5432/fresveg
BOOTSTRAP_DB_USER=fresveg_bootstrap
BOOTSTRAP_DB_PASSWORD=

# Export these separately for the service process after provisioning its passwords.
# Local profile supplies the URL default; production/default profile requires DB_URL.
DB_URL=jdbc:postgresql://localhost:5432/fresveg
DB_PASSWORD=
MIGRATION_DB_PASSWORD=
# DB_USER and MIGRATION_DB_USER default to that service's scoped role names.

# Account/Catalog/Supply/Commerce require a trusted external identity provider; export per process.
OIDC_ISSUER_URI=
OIDC_AUDIENCE=
OIDC_JWK_SET_URI=
# API_DOCS_ENABLED defaults false; local/test profiles default true.

# Catalog uses Account's existing /me API for live stored administrator authority.
ACCOUNT_BASE_URL=http://localhost:8081
# Catalog OIDC_AUDIENCE typically fresveg-catalog; admin access tokens also need Account's audience.

# Supply verifies vendor membership through Account and active product/variant metadata through Catalog.
CATALOG_BASE_URL=http://localhost:8082
# Supply OIDC_AUDIENCE typically fresveg-supply; vendor access tokens also need Account's audience.

# Service subjects issued by the trusted OIDC provider, comma-separated; empty denies reservations.
# Those service tokens must include Supply's audience and scope inventory.reserve.
INVENTORY_SERVICE_SUBJECTS=
INVENTORY_EXPIRATION_ENABLED=true
INVENTORY_EXPIRATION_DELAY_MS=30000

# Commerce cart lookup uses public Supply reads; customer JWTs also need Account's audience.
SUPPLY_BASE_URL=http://localhost:8083
# Commerce OIDC_AUDIENCE typically fresveg-commerce.
OWNER_CONNECT_TIMEOUT_MS=2000
OWNER_REQUEST_TIMEOUT_MS=3000
OWNER_COOLDOWN_MS=5000
OWNER_MAX_CONCURRENT=8

# Explicit merchant-owned checkout configuration as JSON arrays; see docs/commerce/checkout.md.
# Empty defaults preserve cart/health operation but fail closed for unconfigured checkout.
CHECKOUT_DELIVERY_SLOTS=[]
CHECKOUT_PRICING_RULES=[]

# Phase 9: read-only mounted file holding an externally issued Supply service JWT.
# Its subject must be allowed in Supply INVENTORY_SERVICE_SUBJECTS and scope inventory.reserve.
# Rotate the file before expiry. Never put token contents in this file or source control.
# Commerce also uses the existing CATALOG_BASE_URL for authoritative product snapshots.
INVENTORY_SERVICE_TOKEN_FILE=
ORDER_RECOVERY_DELAY_MS=30000

# Phase 10 local payment adapter controls. Leave empty for successful local authorization/refund.
LOCAL_PAYMENT_DECLINED_METHOD_IDS=
LOCAL_PAYMENT_REFUND_FAILURE_ATTEMPT_IDS=

# Phase 11 Fulfillment internal operations. Empty denies service creates/transitions/slot administration.
# Fulfillment OIDC_AUDIENCE typically fresveg-fulfillment.
FULFILLMENT_SERVICE_SUBJECTS=
